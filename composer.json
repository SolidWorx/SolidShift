{
  "license": "MIT",
  "type": "project",
  "authors": [
    {
      "name": "SolidWorx",
      "email": "open-source@solidworx.co",
      "homepage": "https://solidworx.co"
    }
  ],
  "homepage": "https://github.com/SolidWorx/SolidShift",
  "support": {
    "issues": "https://github.com/SolidWorx/SolidShift/issues",
    "source": "https://github.com/SolidWorx/SolidShift",
    "security": "https://github.com/SolidWorx/SolidShift/blob/main/.github/SECURITY.md"
  },
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^4.1",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^2.15",
    "giggsey/libphonenumber-for-php": "^9.0",
    "illuminate/collections": "^12.20",
    "illuminate/conditionable": "^12.20",
    "illuminate/contracts": "^12.20",
    "illuminate/macroable": "^12.20",
    "illuminate/support": "^12.20",
    "nelmio/cors-bundle": "^2.4",
    "nesbot/carbon": "^3.0",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpstan/phpdoc-parser": "^2.1",
    "solidworx/platform": "dev-main",
    "symfony/asset": "^7.3",
    "symfony/console": "^7.3",
    "symfony/doctrine-messenger": "^7.3",
    "symfony/dotenv": "^7.3",
    "symfony/expression-language": "^7.3",
    "symfony/flex": "^2.4",
    "symfony/form": "^7.3",
    "symfony/framework-bundle": "^7.3",
    "symfony/http-client": "^7.3",
    "symfony/intl": "^7.3",
    "symfony/mailer": "^7.3",
    "symfony/mime": "^7.3",
    "symfony/monolog-bundle": "^3.0",
    "symfony/notifier": "^7.3",
    "symfony/process": "^7.3",
    "symfony/property-access": "^7.3",
    "symfony/property-info": "^7.3",
    "symfony/runtime": "^7.3",
    "symfony/security-bundle": "^7.3",
    "symfony/serializer": "^7.3",
    "symfony/stimulus-bundle": "^2.13",
    "symfony/string": "^7.3",
    "symfony/translation": "^7.3",
    "symfony/twig-bundle": "^7.3",
    "symfony/uid": "^7.3",
    "symfony/ux-autocomplete": "^2.27",
    "symfony/ux-live-component": "^2.14",
    "symfony/validator": "^7.3",
    "symfony/web-link": "^7.3",
    "symfony/webpack-encore-bundle": "^2.1",
    "symfony/yaml": "^7.3",
    "symfonycasts/dynamic-forms": "^0.2.0",
    "twig/cssinliner-extra": "^3.8",
    "twig/extra-bundle": "^3.0",
    "twig/inky-extra": "^3.8",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.0",
    "ergebnis/composer-normalize": "^2.41",
    "ergebnis/phpunit-slow-test-detector": "^2.7",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^12.2",
    "rector/rector": "^2.1",
    "roave/security-advisories": "dev-latest",
    "symfony/browser-kit": "^7.3",
    "symfony/css-selector": "^7.3",
    "symfony/debug-bundle": "^7.3",
    "symfony/maker-bundle": "^1.52",
    "symfony/phpunit-bridge": "^7.3",
    "symfony/stopwatch": "^7.3",
    "symfony/web-profiler-bundle": "^7.3",
    "symplify/easy-coding-standard": "^12.0"
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true,
    "audit": {
      "abandoned": "fail"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^7.3"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
