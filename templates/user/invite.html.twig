{% extends 'layouts/base.html.twig' %}

{% block title %}Invite User{% endblock %}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        <div class="row row-cards">
            <div class="col-6 offset-3">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{- block('title') -}}</h3>
                        <div class="mb-3">
                            {% if area is not defined %}
                                <div class="alert alert-indigo" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            {{ icon('alert') }}
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Invite a user to join your site by filling out the details below.</h4>
                                            <div class="text-secondary">
                                                If the user already has an account, they will be added to your site with their existing account details.<br />
                                                If they do not have an account, they will be sent an email with instructions on how to create one.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <a href="javascript: history.back()" class="btn btn-link">Cancel</a>
                                    <button type="submit" class="btn-primary btn">
                                        Invite
                                    </button>
                                </div>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
