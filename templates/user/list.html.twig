{% extends 'layouts/base.html.twig' %}

{% block title %}User List{% endblock %}

{% block page_header %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">
                        Users
                    </h2>
                </div>

                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="{{ url('user.invite') }}" class="btn btn-primary d-none d-sm-inline-block">
                            {{ icon('plus') }}
                            Invite new user
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock page_header %}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        <ul class="nav nav-bordered mb-4">
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="{{ path('user.list') }}">Users</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('user.invite.list') }}">Invites</a>
            </li>
        </ul>

        <div class="card mb-3">
            <div class="card-body">
                <h3 class="card-title">Self-registration link</h3>
                <p class="text-secondary mb-3">
                    Share this URL so anyone can register themselves as a member of {{ site.name }}.
                    Rotate it to invalidate any leaked copies.
                </p>

                {% if site.selfRegistrationToken %}
                    {% set joinUrl = url('site.self_register', {token: site.selfRegistrationToken}) %}
                    <div class="clipboard-container mb-3" data-controller="clipboard">
                        <pre data-clipboard-target="source">{{ joinUrl }}</pre>
                        <a class="copy-btn" href="#" data-action="clipboard#copy">{{ icon('link') }}</a>
                    </div>

                    <form method="post" action="{{ path('user.self_registration_link', {action: 'rotate'}) }}" class="d-inline">
                        <button type="submit" class="btn btn-secondary">Rotate</button>
                    </form>
                    <form method="post" action="{{ path('user.self_registration_link', {action: 'disable'}) }}" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger">Disable</button>
                    </form>
                {% else %}
                    <p class="text-secondary mb-3"><em>Self-registration is disabled.</em></p>
                    <form method="post" action="{{ path('user.self_registration_link', {action: 'rotate'}) }}">
                        <button type="submit" class="btn btn-primary">{{ icon('link') }} Generate link</button>
                    </form>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Membership</th>
                        <th>Job roles</th>
                        <th class="w-1"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for userAccess in users %}
                        <tr>
                            <td>
                                <div class="d-flex py-1 align-items-center">
                                        <span class="avatar me-2">
                                            {% if userAccess.user.firstName is not empty %}
                                                {{ userAccess.user.firstName|first|title }}
                                            {%- endif -%}
                                            {%- if userAccess.user.lastName is not empty -%}
                                                {{ userAccess.user.lastName|first|title }}
                                            {% endif %}
                                        </span>
                                    <div class="flex-fill">
                                        <div class="font-weight-medium">{{ userAccess.user.fullName }}</div>
                                        <div class="text-secondary">
                                            <a href="mailto:{{ userAccess.user.username }}" class="text-reset">{{ userAccess.user.username }}</a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if userAccess.user.phone is not empty %}
                                    <a href="tel:{{ userAccess.user.phone }}">{{ userAccess.user.phone|format_phone }}</a>
                                {% endif %}
                            </td>
                            <td class="text-secondary">
                                {{ userAccess.role.value|title }}
                            </td>
                            <td>
                                {% for role in userAccess.user.getRolesForSite(site) %}
                                    <span class="badge bg-blue-lt">{{ role.name }}</span>
                                {% else %}
                                    <span class="text-secondary"><em>None</em></span>
                                {% endfor %}
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="{{ path('user.edit', {user: userAccess.user.id}) }}" class="btn btn-sm">Manage</a>
                                    {% if userAccess.user is not same as(app.user) %}
                                        {% embed 'ui/modal/confirm.html.twig' with {url: 'user.remove', parameters: {user: userAccess.user.id}} %}
                                            {% block title %}
                                                Are you sure you want to delete the user {{ userAccess.user.fullName }}?
                                            {% endblock %}

                                            {% block content %}
                                                Deleting the user will remove all their access from {{ site.name }}.
                                            {% endblock content %}
                                        {% endembed %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock body %}

