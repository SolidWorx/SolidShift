{% extends 'layouts/empty.html.twig' %}

{% block title %}Accept Invite!{% endblock %}

{% block body %}
    <div class="card card-md">
        <div class="card-body">
            {{ form_start(form) }}
            <h2 class="h2 text-center mb-4">Register a new account</h2>

            <div class="alert alert-indigo">
                <div class="d-flex">
                    <div>
                        {{ icon('alert') }}
                    </div>
                    <div>
                        <h4 class="alert-title">Register a new account to accept the invite to join {{ userInvite.site }}.</h4>
                        <div class="text-secondary">
                            <p>Once you have registered, you will be able to access {{ userInvite.site }} and start scheduling shifts.</p>
                            <p>If you already have an account, you can <a href="{{ path('app_login') }}">login here</a>.</p>
                        </div>
                    </div>
                </div>
            </div>

            {{ form_row(form) }}

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Register</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
