<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            {% if action is defined and action is same as('choose') %}
                Choose Site
            {% else %}
                Switch Site
            {% endif %}
        </h3>
    </div>
    <div class="list-group list-group-flush list-group-hoverable">
        {% for userSite in app.user.siteAccess|filter((s) => not s.site.id.equals(site.id)) %}
            <div class="list-group-item">
                <div class="row align-items-center">
                    <a href="{{ url('dashboard', {'site': userSite.site.id.toBase58()}) }}" class="text-body d-block">
                        {{ userSite.site }}
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
