<div class="card">
    {% if app.user.siteAccess|length > 1 %}
        <div class="card-header">
            <h3 class="card-title">
                {% if action is defined and action is same as('choose') %}
                    Choose Site
                {% else %}
                    Switch Site
                {% endif %}
            </h3>
        </div>
    {% endif %}
    <div class="list-group list-group-flush list-group-hoverable">
        {% for userSite in app.user.siteAccess|filter((s) => not s.site.id.equals(site.id)) %}
            <div class="list-group-item">
                <div class="row align-items-center">
                    <a href="{{ url('dashboard', {'site': userSite.site.id.toBase58()}) }}" class="text-body d-block">
                        {{ userSite.site }}
                    </a>
                </div>
            </div>
        {% endfor %}

        <div class="list-group-item">
            <div class="row align-items-center">
                <a href="{{ path('app_create_site') }}" class="text-body d-block">
                    {{ ux_icon('tabler:circle-plus', {width: 20}) }} {{ 'Create Site'|trans }}
                </a>
            </div>
        </div>
    </div>
</div>
