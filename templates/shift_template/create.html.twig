{% extends 'layouts/base.html.twig' %}

{%- block title -%}
    {% if shiftTemplate is defined %}
        Edit {{ shiftTemplate.name }}
    {% else %}
        Create Shift Template
    {% endif %}
{%- endblock title -%}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        <div class="row row-cards">
            <div class="col-6 offset-3">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{- block('title') -}}</h3>
                        <div class="mb-3">
                            {% if shiftTemplate is not defined %}
                                <div class="alert alert-indigo" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            {{ icon('alert') }}
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Create a new shift template by giving it a name, position, and location.</h4>
                                            <div class="text-secondary">
                                                A shift template represents a recurring shift in your schedule.<br />
                                                You can set optional start and end times for each shift template.<br />
                                                Each shift template requires a position and location.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <a href="javascript: history.back()" class="btn btn-link">Cancel</a>
                                    <button type="submit" class="btn-primary btn">
                                        Save
                                    </button>
                                </div>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
