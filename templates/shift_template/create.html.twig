{% extends 'layouts/base.html.twig' %}

{%- block title -%}
    {% if shiftTemplate is defined and shiftTemplate.name %}
        Edit {{ shiftTemplate.name }}
    {% else %}
        Create Shift Template
    {% endif %}
{%- endblock title -%}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        <div class="row row-cards">
            <div class="col-6 offset-3">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{- block('title') -}}</h3>
                        <div class="mb-3">
                            {% if shiftTemplate is not defined or not shiftTemplate.name %}
                                <div class="alert alert-indigo" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            {{ icon('alert') }}
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Create a new shift template by giving it a name, role, and area.</h4>
                                            <div class="text-secondary">
                                                A shift template represents a recurring shift in your schedule.<br />
                                                You can set optional start and end times for each shift template.<br />
                                                Each shift template requires a role and area.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            <twig:ShiftTemplateForm :initialFormData="shiftTemplate" :site="site" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
