{% extends 'layouts/base.html.twig' %}

{% block title %}Shift Template List{% endblock %}

{% block page_header %}
    {% if shiftTemplates is not empty %}
        <div class="page-header d-print-none">
            <div class="container-xl">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <h2 class="page-title">
                            Shift Templates
                        </h2>
                    </div>

                    <div class="col-auto ms-auto d-print-none">
                        <div class="btn-list">
                            <a href="{{ url('shift_template.create') }}" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-create-shift-template">
                                {{ icon('plus') }}
                                Create
                            </a>
                            <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-create-shift-template" aria-label="Create">
                                {{ icon('plus') }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock page_header %}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        {% if shiftTemplates is empty %}
            <div class="empty">
                <div class="empty-img">
                    {{ include('components/illustration/location.html.twig', {label: 'No shift templates'}) }}
                </div>
                <p class="empty-title">No shift templates found</p>
                <p class="empty-subtitle text-secondary">
                    Shift templates define recurring shifts that can be assigned to specific positions and locations.
                    <br />
                    You can set optional start and end times for each shift template.
                    <br />
                    Each shift template requires a position and location.
                </p>
                <div class="empty-action">
                    <a href="{{ url('shift_template.create') }}" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M12 5l0 14"></path>
                            <path d="M5 12l14 0"></path>
                        </svg>
                        Add your first shift template
                    </a>
                </div>
            </div>
        {% else %}
            <div class="alert alert-indigo" role="alert">
                <div class="d-flex">
                    <div>
                        {{ icon('alert') }}
                    </div>
                    <div>
                        <div class="text-secondary">
                            Shift templates define recurring shifts that can be assigned to specific positions and locations.
                            <br />
                            You can set optional start and end times for each shift template.
                            <br />
                            Each shift template requires a position and location.
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Shift Templates</h3>
                </div>
                <div class="list-group list-group-flush">
                    {% for shiftTemplate in shiftTemplates %}
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                {{ shiftTemplate.name }}
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="badge bg-teal text-white ms-2">
                                        {{ shiftTemplate.position }}
                                        {% if shiftTemplate.requiredMin > 0 or shiftTemplate.requiredMax > 0 %}
                                            ({{ shiftTemplate.requiredMin|default(1) == shiftTemplate.requiredMax|default(shiftTemplate.requiredMin|default(1)) ?  shiftTemplate.requiredMin|default(shiftTemplate.requiredMax) : (shiftTemplate.requiredMin ~ ' - ' ~ shiftTemplate.requiredMax) }})
                                        {% endif %}
                                    </span>
                                    <span class="badge bg-blue text-white ms-2">{{ shiftTemplate.location }}</span>
                                    {% if shiftTemplate.startTime %}
                                        <span class="badge bg-green text-white ms-2">{{ shiftTemplate.startTime|date('H:i') }}</span>
                                    {% endif %}
                                    {% if shiftTemplate.endTime %}
                                        <span class="badge bg-red text-white ms-2">{{ shiftTemplate.endTime|date('H:i') }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div>
                                <a href="{{ url('shift_template.edit', {shiftTemplate: shiftTemplate.id}) }}" class="btn btn-sm btn-action btn-ghost-light" data-bs-toggle="tooltip" title="Edit Shift Template" data-bs-placement="top">
                                    {{ icon('pencil') }}
                                </a>

                                <a href="#" class="btn btn-sm btn-action btn-ghost-light" title="Delete Shift Template" data-bs-toggle="modal" data-bs-target="#modal-delete-{{ shiftTemplate.id }}">
                                    {{ icon('trash') }}
                                </a>
                            </div>
                        </div>

                        {% embed 'ui/modal/confirm.html.twig' with {url: 'shift_template.delete', parameters: {shiftTemplate: shiftTemplate.id}, id: shiftTemplate.id} %}
                            {% block trigger %}{% endblock trigger %}
                            {% block title %}
                                Are you sure you want to delete the shift template {{ shiftTemplate.name }}?
                            {% endblock %}
                            {% block content %}
                            {% endblock %}
                        {% endembed %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock body %}

{% block page_end %}
    <div class="modal modal-blur fade" id="modal-create-shift-template" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                {{ form_start(form, {'action': path('shift_template.create')}) }}
                <div class="modal-header">
                    <h5 class="modal-title">New Shift Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="alert alert-indigo" role="alert">
                            <div class="d-flex">
                                <div>
                                    {{ icon('alert') }}
                                </div>
                                <div>
                                    <h4 class="alert-title">Create a new shift template by giving it a name, position, and location.</h4>
                                    <div class="text-secondary">
                                        A shift template represents a recurring shift in your schedule.<br />
                                        You can set optional start and end times for each shift template.
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{ form_widget(form) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary ms-auto">
                        {{ icon('plus') }}
                        Create
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock page_end %}
