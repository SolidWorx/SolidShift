<div{{ attributes.defaults({class: 'ss-roster'}) }}>
    <div class="roster-controls">
        <div class="ctrl">
            <span class="lbl">Window</span>
            <select class="form-select" data-model="weeks">
                <option value="1" {{ weeks == 1 ? 'selected' }}>1 week</option>
                <option value="2" {{ weeks == 2 ? 'selected' }}>2 weeks</option>
                <option value="4" {{ weeks == 4 ? 'selected' }}>4 weeks</option>
                <option value="8" {{ weeks == 8 ? 'selected' }}>8 weeks</option>
            </select>
        </div>

        <label class="form-check form-switch m-0 ms-auto">
            <input class="form-check-input"
                   type="checkbox"
                   id="roster-include-all"
                   {% if includeAllUsers %}checked{% endif %}
                   data-model="includeAllUsers" />
            <span class="form-check-label" for="roster-include-all">
                Include all site members
            </span>
        </label>
    </div>

    {% if grid.columns is empty %}
        <div class="roster-card">
            <div class="empty">
                <p class="empty-title">No upcoming shifts</p>
                <p class="empty-subtitle text-secondary">
                    No shifts to roster in this window.
                </p>
            </div>
        </div>
    {% else %}
        {% set totalFilled = 0 %}
        {% set totalNeeded = 0 %}
        {% set openSpots = 0 %}
        {% set warningCount = 0 %}
        {% for column in grid.columns %}
            {% set count = column.assigned|length %}
            {% set min = column.requirement.requiredMin ?? 0 %}
            {% set max = column.requirement.requiredMax ?? min %}
            {% set totalFilled = totalFilled + count %}
            {% set totalNeeded = totalNeeded + max %}
            {% set openSpots = openSpots + max(0, min - count) %}
            {% for shift in column.assigned %}
                {% if this.warningsFor(shift.user, column.requirement, column.occurrence) is not empty %}
                    {% set warningCount = warningCount + 1 %}
                {% endif %}
            {% endfor %}
        {% endfor %}

        <div class="roster-card">
            <div class="roster-scroll">
                <table class="roster-table">
                    <colgroup>
                        <col style="width: 220px;" />
                        {% for column in grid.columns %}
                            <col style="width: 116px;" />
                        {% endfor %}
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="user-head">User</th>
                            {% for column in grid.columns %}
                                {% set req = column.requirement %}
                                {% set rc = this.roleColor(req.role) %}
                                {% set count = column.assigned|length %}
                                {% set min = req.requiredMin %}
                                {% set max = req.requiredMax %}
                                {% set status = this.statusFor(req, column.assigned) %}
                                {% set target = max ?? min ?? 1 %}
                                {% set progressPct = target > 0 ? min(100, (count / target) * 100) : 0 %}
                                {% set fillColor = status in ['under', 'empty'] ? 'var(--status-under)'
                                                  : status == 'over' ? 'var(--status-over)'
                                                  : 'var(--status-full)' %}
                                {% set countColor = status == 'under' ? 'var(--status-under)'
                                                   : status == 'over' ? 'var(--status-over)'
                                                   : status == 'empty' ? '#A16207'
                                                   : 'var(--status-full)' %}
                                {% set reqStart = req.startTime ?? column.scheduleDate.startTime %}
                                {% set reqEnd = req.endTime ?? column.scheduleDate.endTime %}
                                <th class="shift-head{{ this.isToday(column.scheduleDate.startDate) ? ' today' : '' }}"
                                    style="border-top: 3px solid {{ rc.color }};">
                                    <div class="meta">
                                        <div class="when">{{ column.scheduleDate.startDate|date('D, d M') }}</div>
                                        {% if reqStart or reqEnd %}
                                            <div class="time">
                                                {% if reqStart %}{{ reqStart|date('H:i') }}{% endif %}{% if reqStart and reqEnd %}–{% endif %}{% if reqEnd %}{{ reqEnd|date('H:i') }}{% endif %}
                                            </div>
                                        {% endif %}
                                        <span class="role-chip" style="color: {{ rc.color }}; background: {{ rc.bg }};">
                                            <span class="dot" style="background: {{ rc.color }};"></span>
                                            {{ req.role }}
                                        </span>
                                        {% if req.area %}
                                            <div class="area" title="{{ req.area }}">{{ req.area }}</div>
                                        {% endif %}
                                        <div class="fill">
                                            <span class="count" style="color: {{ countColor }};">
                                                {{ count }}/{% if min is not null and max is not null and min != max %}{{ min }}–{{ max }}{% else %}{{ max ?? min ?? 0 }}{% endif %}
                                            </span>
                                            <div class="bar">
                                                <div style="width: {{ progressPct }}%; background: {{ fillColor }};"></div>
                                            </div>
                                        </div>
                                    </div>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in grid.rows %}
                            {% set userRoles = user.getRolesForSite(site) %}
                            <tr>
                                <td class="user-cell">
                                    <div class="user-info">
                                        <span class="av" data-tone="{{ this.avatarTone(user) }}">{{ this.initials(user) }}</span>
                                        <div style="min-width: 0;">
                                            <div class="nm">{{ user.fullName }}</div>
                                            <div class="roles">
                                                {% for role in userRoles|slice(0, 2) %}
                                                    {% set urc = this.roleColor(role) %}
                                                    <span class="role-mini" style="color: {{ urc.color }}; background: {{ urc.bg }};">
                                                        {{ role }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                {% for index, column in grid.columns %}
                                    {% set cellKey = index ~ ':' ~ user.id %}
                                    {% set shift = grid.cells[cellKey]|default(null) %}
                                    {% set warnings = this.warningsFor(user, column.requirement, column.occurrence) %}
                                    {% set isEligible = false %}
                                    {% for role in userRoles %}
                                        {% if role.id == column.requirement.role.id %}
                                            {% set isEligible = true %}
                                        {% endif %}
                                    {% endfor %}
                                    {% set cellClass = 'cell' %}
                                    {% if shift %}
                                        {% set cellClass = cellClass ~ (warnings ? ' warn' : ' filled') %}
                                    {% endif %}
                                    <td class="{{ cellClass }}">
                                        {% if shift %}
                                            <span class="cell-assigned {{ warnings ? 'warn' : 'ok' }}"
                                                  title="{{ user.fullName }}{% if warnings %} · {{ warnings|join(' • ') }}{% endif %}">
                                                {% if warnings %}
                                                    {{ ux_icon('tabler:alert-triangle-filled', {width: 12, height: 12}) }}
                                                {% else %}
                                                    {{ ux_icon('tabler:check', {width: 12, height: 12}) }}
                                                {% endif %}
                                                <a href="#"
                                                   class="x"
                                                   title="Unassign"
                                                   {{ live_action('unassign:prevent', {shift: shift.id}) }}>×</a>
                                            </span>
                                        {% else %}
                                            <button type="button"
                                                    class="cell-add{{ isEligible ? '' : ' ineligible' }}"
                                                    {% if isEligible %}
                                                        title="Assign {{ user.fullName }} to {{ column.requirement.role }}{% if warnings %} · {{ warnings|join(' • ') }}{% endif %}"
                                                        {{ live_action('assign:prevent', {userId: user.id, requirementId: column.requirement.id, occurrenceId: column.occurrence.id}) }}
                                                    {% else %}
                                                        title="Not eligible for this role"
                                                        disabled
                                                    {% endif %}>
                                                {{ ux_icon('tabler:plus', {width: 13, height: 13}) }}
                                            </button>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="roster-footer">
                <div class="item">
                    <strong>{{ totalFilled }}</strong> / <strong>{{ totalNeeded }}</strong> spots filled
                </div>
                {% if openSpots > 0 %}
                    <div class="item">
                        <span class="legend-sw legend-dashed"></span>
                        <strong style="color: var(--status-under);">{{ openSpots }}</strong> still needed
                    </div>
                {% endif %}
                {% if warningCount > 0 %}
                    <div class="item">
                        <span class="legend-sw legend-warn"></span>
                        <strong style="color: #B45309;">{{ warningCount }}</strong> warning{{ warningCount == 1 ? '' : 's' }}
                    </div>
                {% endif %}
                <div class="item ms-auto">
                    <span class="legend-sw legend-filled"></span>
                    Assigned
                </div>
                <div class="item">
                    <span class="legend-sw legend-dashed"></span>
                    Open spot
                </div>
            </div>
        </div>
    {% endif %}
</div>
