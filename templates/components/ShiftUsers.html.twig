<div{{ attributes }}>
    <a href="#" data-bs-toggle="modal" data-bs-target="#{{ scheduleDate.hash }}">
        {{ icon('plus') }} {{ 'Schedule Users'|trans }}
    </a>

    {% if shift is not empty %}
        <div class="tags-list">
            {% for assignment in shift.assignments %}
                <span class="tag">
                    {{ assignment.user }}
                    <a href="#" class="btn-close" data-action="live#action" data-action-name="prevent|removeUser(assignment={{ assignment.id }}, shift={{ shift.id }})"></a>
                </span>
            {% endfor %}
        </div>
    {% endif %}

    <twig:Ui:Modal id="{{ scheduleDate.hash }}" title="Assign users to shift">
        {{ form_start(form, {
            attr: {
                'data-action': 'live#action',
                'data-action-name': 'prevent|save',
            }
        }) }}

        {{ form_row(form.users) }}
        {#{{ form_row(form.location) }}#}
        <button type="submit" class="btn btn-primary">Save</button>
        {{ form_end(form) }}
    </twig:Ui:Modal>
</div>
