<div{{ attributes }}>
    <a href="#" data-bs-toggle="modal" data-bs-target="#{{ scheduleDate.hash }}">
        {{ icon('plus') }} Add Users
    </a>

    {% if shift is not empty %}
        <div class="tags-list">
            {% for user in shift.users %}
                <span class="tag">
                    {{ user.fullName }}
                    <a href="#" class="btn-close" data-action="live#action" data-action-name="prevent|removeUser(user={{ user.id }}, shift={{ shift.id }})"></a>
                </span>
            {% endfor %}
        </div>
    {% endif %}

    <twig:Ui:Modal id="{{ scheduleDate.hash }}" title="Assign users to shift">
        {{ form_start(form, {
            attr: {
                'data-action': 'live#action',
                'data-action-name': 'prevent|save',
            }
        }) }}

        {{ form_row(form.users) }}
        <button type="submit" class="btn btn-primary">Save</button>
        {{ form_end(form) }}
    </twig:Ui:Modal>
</div>
