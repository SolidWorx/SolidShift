<div{{ attributes }}>
    {% if requirements is empty %}
        <p class="text-secondary mb-0">
            <em>No staffing requirements on this sub-event.</em>
        </p>
    {% else %}
        <div class="list-group list-group-flush">
            {% for requirement in requirements %}
                {% set assigned = this.assignedShifts(requirement) %}
                {% set assignedCount = assigned|length %}
                {% set min = requirement.requiredMin %}
                {% set max = requirement.requiredMax %}
                {% set target = max ?? min ?? 0 %}
                {% set progressPct = target > 0 ? min(100, (assignedCount / target) * 100) : 0 %}
                {% if min is not null and assignedCount < min %}
                    {% set progressColor = 'bg-red' %}
                {% elseif max is not null and assignedCount > max %}
                    {% set progressColor = 'bg-warning' %}
                {% else %}
                    {% set progressColor = 'bg-success' %}
                {% endif %}
                {% set isOpen = openRequirementId == requirement.id ~ '' %}

                <div class="list-group-item px-0 py-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1 me-3">
                            <strong>{{ requirement.role }}</strong>
                            {% if requirement.area %}
                                <span class="badge bg-blue-lt">{{ requirement.area }}</span>
                            {% endif %}
                            <small class="text-secondary d-block">
                                {{ assignedCount }} assigned
                                {% if min is not null or max is not null %}
                                    (need
                                    {% if min is not null %}min {{ min }}{% endif %}
                                    {% if min is not null and max is not null %}, {% endif %}
                                    {% if max is not null %}max {{ max }}{% endif %})
                                {% endif %}
                            </small>
                            {% if target > 0 %}
                                <div class="progress progress-sm mt-1" style="max-width: 220px;">
                                    <div class="progress-bar {{ progressColor }}" style="width: {{ progressPct }}%"></div>
                                </div>
                            {% endif %}
                        </div>
                        <button type="button"
                                class="btn btn-sm {{ isOpen ? 'btn-secondary' : 'btn-outline-secondary' }}"
                                data-action="live#action:prevent"
                                data-live-action-param="toggleRequirement"
                                data-live-requirement-id-param="{{ requirement.id }}">
                            {{ isOpen ? 'Close' : 'Assign' }}
                        </button>
                    </div>

                    {% if assignedCount > 0 %}
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            {% for shift in assigned %}
                                {% set warnings = this.warningsForShift(shift) %}
                                <span class="badge bg-green-lt d-inline-flex align-items-center"
                                      {% if warnings %}title="{{ warnings|join(' • ') }}"{% endif %}>
                                    {% if warnings %}
                                        <span class="status-dot bg-warning me-1"></span>
                                    {% endif %}
                                    {{ shift.user }}
                                    <a href="#"
                                       class="ms-1 text-reset"
                                       data-action="live#action:prevent"
                                       data-live-action-param="removeUser"
                                       data-live-shift-param="{{ shift.id }}"
                                       title="Unassign"
                                    >&times;</a>
                                </span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if isOpen %}
                        <div class="mt-3 p-3 border rounded bg-light">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="include-all-{{ requirement.id }}"
                                       {% if includeAllUsers %}checked{% endif %}
                                       data-model="includeAllUsers" />
                                <label class="form-check-label small" for="include-all-{{ requirement.id }}">
                                    Show all site members (warn when role not assigned)
                                </label>
                            </div>

                            {{ form_start(form, {
                                attr: {
                                    'data-action': 'live#action:prevent',
                                    'data-live-action-param': 'save',
                                }
                            }) }}
                            {{ form_row(form.users) }}
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button"
                                        class="btn btn-link"
                                        data-action="live#action"
                                        data-live-action-param="prevent|toggleRequirement"
                                        data-live-requirement-id-param="{{ requirement.id }}">
                                    Cancel
                                </button>
                                <button type="submit" class="btn btn-primary">Assign</button>
                            </div>
                            {{ form_end(form, {render_rest: false}) }}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
