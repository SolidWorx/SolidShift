<div{{ attributes }}>
    {% if computed.shiftDates is empty %}
        <div class="empty">
            <div class="empty-img">
                {{ include('components/illustration/area.html.twig', {label: 'No upcoming shifts'}) }}
            </div>
            <p class="empty-title">{{ 'No shifts found'|trans }}</p>
            <p class="empty-subtitle text-secondary">
                Create a <a href="{{ path('schedule.create') }}">new schedule</a> to start assigning shifts
            </p>
            <div class="empty-action">
                <a href="{{ url('schedule.create') }}" class="btn btn-primary">
                    {{ icon('plus') }}
                    {{ 'Add your first schedule'|trans }}
                </a>
            </div>
        </div>
    {% else %}
        <div class="container mt-3">
            {% set currentDate = null %}

            {% for area, dates in computed.shiftDates %}

                {% if currentDate != dates|first.startDate|date('Y-m') %}
                    <h2 class="mb-3 page-title">
                        {{ dates|first.startDate|date('F Y') }}
                    </h2>
                    {% set currentDate = dates|first.startDate|date('Y-m') %}
                {% endif %}

                <div class="list-group mb-4">
                    <div class="d-flex w-100 list-group-item align-items-stretch">
                        <span class="timeline-date-pill">
                            {{ area|date('D') }}
                            <br />
                            {{ area|date('d') }}
                        </span>
                        <div class="border-2 flex-grow-1 border-left border-indigo border-start ps-3 ms-3">
                            {% for shiftDate in dates %}
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <h3 class="mb-1">{{ shiftDate.schedule.name }}</h3>
                                        <p class="mb-1 text-secondary">
                                            {{ shiftDate.occurrenceTemplate.name }}
                                        </p>
                                        {% if shiftDate.timeRange is not empty %}
                                            <span class="tag">
                                                {{ shiftDate.timeRange }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="col-md-9">
                                        <twig:ShiftUsers :shiftDate="shiftDate" />
                                    </div>
                                </div>

                                {% if not loop.last %}
                                    <hr />
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>

                </div>
            {% endfor %}
        </div>

        <style>
            .timeline-date-pill {
                width: 4rem;
                height: 4rem;
                font-size: 1.1rem;
                line-height: 1.1;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border-radius: 50%;
                background-color: var(--tblr-bg-surface-secondary, #f1f5f9);
                color: var(--tblr-secondary, #626976);
                text-align: center;
                font-weight: 500;
            }
        </style>
    {% endif %}
</div>
