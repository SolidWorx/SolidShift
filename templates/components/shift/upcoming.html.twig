{# @var dates Collection<int, Collection<int, App\Model\ScheduleDate>> #}
<div{{ attributes }}>
    {% if computed.shiftDates is empty %}
        <div class="empty">
            <div class="empty-img">
                {{ include('components/illustration/area.html.twig', {label: 'No upcoming shifts'}) }}
            </div>
            <p class="empty-title">{{ 'No shifts found'|trans }}</p>
            <p class="empty-subtitle text-secondary">
                Create a <a href="{{ path('schedule.create') }}">new schedule</a> to start assigning shifts
            </p>
            <div class="empty-action">
                <a href="{{ url('schedule.create') }}" class="btn btn-primary">
                    {{ icon('plus') }}
                    {{ 'Add your first schedule'|trans }}
                </a>
            </div>
        </div>
    {% else %}
        {# Flatten the per-day groupings into a single ordered list, then re-group by month. #}
        {% set allDates = [] %}
        {% for _, dayGroup in computed.shiftDates %}
            {% for scheduleDate in dayGroup %}
                {% set allDates = allDates|merge([scheduleDate]) %}
            {% endfor %}
        {% endfor %}

        {% set byMonth = {} %}
        {% for scheduleDate in allDates %}
            {% set monthKey = scheduleDate.startDate|date('Y-m') %}
            {% set bucket = byMonth[monthKey]|default([]) %}
            {% set bucket = bucket|merge([scheduleDate]) %}
            {% set byMonth = byMonth|merge({(monthKey): bucket}) %}
        {% endfor %}

        <div class="ss-timeline">
            {% for monthKey, monthDates in byMonth %}
                {% set monthLabel = monthDates|first.startDate|date('F Y') %}
                <div class="ss-monthhead">
                    <h2>{{ monthLabel }}</h2>
                    <span class="sub">
                        {{ monthDates|length }} shift{{ monthDates|length == 1 ? '' : 's' }}
                    </span>
                    <span class="rule"></span>
                </div>

                {% for scheduleDate in monthDates %}
                    <twig:ShiftUsers :shiftDate="scheduleDate" />
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}
</div>
