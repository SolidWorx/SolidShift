<div{{ attributes }}>
    {% if computed.shiftDates is empty %}
        <div class="empty">
            <div class="empty-img">
                <img src="{{ asset('asset/illustration/location.svg') }}" height="128" alt="Location Icon">
            </div>
            <p class="empty-title">No shifts found</p>
            {# <p class="empty-subtitle text-secondary">
                Schedules are used to assign people to locations and times. <br />
                A schedule can be a one-time event or a recurring event.<br />
            </p> #}
            <div class="empty-action">
                {# <a href="{{ url('schedule.create') }}" class="btn btn-primary">
                    {{ icon('plus') }}
                    Add your first schedule
                </a> #}
            </div>
        </div>
    {% else %}
        <div class="card">
            {# <div class="card-header">
                {{ form_start(form) }}
            #}{# {{ form_widget(this.filters.location, {'attr': {'data-model': 'query'}}) }} #}{#
            {{ form_row(form.location, {'attr': {'data-model': 'query'}}) }}
            {{ form_end(form) }}

        </div> #}
            <div class="card-body">
                <div class="container mt-3">

                    <div class="row g-2 align-items-center mb-4">
                        <div class="col">
                            <h2 class="page-title">
                                Upcoming Shifts
                            </h2>
                        </div>

                        {#<div class="col-auto ms-auto d-print-none">
                            <div class="btn-list">
                                <a href="{{ url('schedule.create') }}" class="btn btn-primary d-none d-sm-inline-block">
                                    {{ icon('plus') }}
                                    Add Shift
                                </a>
                                <a href="{{ url('schedule.create') }}" class="btn btn-primary d-sm-none btn-icon" aria-label="Create new Schedule">
                                    {{ icon('plus') }}
                                </a>
                            </div>
                        </div>#}
                    </div>

                    {% for location, dates in computed.shiftDates %}
                        <div class="list-group mb-4">
                            <div class="d-flex w-100 justify-content-between align-items-center list-group-item">
                                <span class="badge badge-light rounded-pill">
                                    {{ location|date('d') }}
                                    <br />
                                    {{ location|date('M') }}
                                </span>
                                <div class="border-2 flex-grow-1 border-left border-indigo border-start ps-3 ms-3">
                                    {% for shiftDate in dates %}
                                        <div class="row">
                                            <div class="col-3">
                                                <h3 class="mb-1">{{ shiftDate.schedule.name }}</h3>
                                                <p class="mb-1">
                                                    {{ shiftDate.schedule.location }}
                                                </p>
                                                {% if shiftDate.timeRange is not empty %}
                                                    <span class="tag">
                                                        {{ shiftDate.timeRange }}
                                                    </span>
                                                {% endif %}
                                            </div>

                                            <div class="col">
                                                <twig:ShiftUsers :shiftDate="shiftDate" />
                                            </div>
                                        </div>

                                        {% if not loop.last %}
                                            <hr />
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>

                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <style>
            .list-group-item .badge {
                width: 5rem;
                height: 5rem;
                font-size: 1.5rem;
                display: flex;
                align-items: center;
                flex-shrink: 0;
                justify-content: center;
                border-radius: 50%;
            }
        </style>
    {% endif %}
</div>
