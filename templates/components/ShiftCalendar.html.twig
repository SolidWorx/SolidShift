<div{{ attributes }}>
    <div class="row mb-2">
        <div class="col px-0">
            <a href="#" class="btn btn-icon" {{ live_action('previous:prevent') }}>
                {{ icon('chevron-left') }}
            </a>

            <a href="#" class="btn" {{ live_action('today:prevent') }}>
                {{ icon('history') }}
                Today
            </a>
        </div>
        <div class="col">
            <h3 class="text-center">
                {{ startDate|date('F Y') }}
            </h3>
        </div>
        <div class="col text-right px-0" style="text-align: right">
            {% if displayType.value is same as('month') %}
                <button type="button" class="btn" data-action="live#update" data-model="displayType" data-value="week">
                    {{ icon('calendar-week') }}
                    Week View
                </button>
            {% else %}
                <button type="button" class="btn" data-action="live#update" data-model="displayType" data-value="month">
                    {{ icon('calendar-month') }}
                    Month View
                </button>
            {% endif %}
            <a href="#" class="btn btn-icon" {{ live_action('next:prevent') }}>
                {{ icon('chevron-right') }}
            </a>
        </div>
    </div>
    <div class="row">
        {% for header in computed.calendar.headers %}
            <div class="col p-0">
                <div class="card rounded-0">
                    <div class="card-body pt-1 px-2">
                        <h3 class="card-title">
                            {{ header.name }}
                        </h3>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% for week in computed.calendar.dates|batch(7) %}
        <div class="row">
            {% for day in week|filter(v => not computed.calendar.shouldSkipDate(v)) %}
                {% set outsideCurrentMonth = displayType.value is not same as('week') and (day < computed.calendar.firstDayOfMonth or day > computed.calendar.lastDayOfMonth) %}
                {% set dayKey = day|date('Y-m-d') %}
                {% set dayEntries = computed.shiftDates[dayKey]|default([]) %}

                <div class="col p-0 d-flex">
                    <div class="card flex-fill rounded-0{{ outsideCurrentMonth ? ' bg-gray-500' }}">
                        <div class="card-body pt-1 px-2">
                            <h3 class="card-title mb-1">
                                <span{{ day.isToday ? ' class="badge badge-pill badge-outline bg-primary text-white"' }}>
                                    {{ day|date('j') }}
                                </span>
                            </h3>

                            {% if dayEntries|length == 0 %}
                                <div class="text-secondary small">&nbsp;</div>
                            {% else %}
                                <div class="list-group list-group-flush small">
                                    {% for shiftDate in dayEntries %}
                                        {% set template = shiftDate.occurrenceTemplate %}
                                        <div class="list-group-item px-0 py-1">
                                            <div class="fw-medium text-truncate">
                                                {{ template.name }}
                                            </div>
                                            {% if shiftDate.timeRange is not empty %}
                                                <div class="text-secondary">{{ shiftDate.timeRange }}</div>
                                            {% endif %}
                                            <div class="text-secondary text-truncate">
                                                {{ shiftDate.schedule.name }}
                                            </div>
                                            <a href="#" class="btn btn-sm btn-link p-0" data-bs-toggle="modal" data-bs-target="#manage-{{ shiftDate.hash }}">
                                                Manage
                                            </a>

                                            <twig:Ui:Modal id="manage-{{ shiftDate.hash }}" title="{{ template.name }} — {{ day|date('d M Y') }}">
                                                <twig:ShiftUsers :shiftDate="shiftDate" />
                                            </twig:Ui:Modal>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
