{% extends 'layouts/base.html.twig' %}

{%- block title -%}
    {% if area is defined %}
        Edit {{ area.name }}
    {% else %}
        Create Area
    {% endif %}
{%- endblock title -%}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        <div class="row row-cards">
            <div class="col-6 offset-3">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{- block('title') -}}</h3>
                        <div class="mb-3">
                            {% if area is not defined %}
                                <div class="alert alert-indigo" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            {{ icon('alert') }}
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Create a new area by giving it a unique name.</h4>
                                            <div class="text-secondary">
                                                A area is any place where a person can be scheduled to be on duty.<br />
                                                This could be a physical area, like an office or an area in the building, <br />
                                                or it can be a team or department within the organization.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <a href="javascript: history.back()" class="btn btn-link">Cancel</a>
                                    <button type="submit" class="btn-primary btn">
                                        Save
                                    </button>
                                </div>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
