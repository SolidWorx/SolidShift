{% extends 'layouts/base.html.twig' %}

{% block title %}Area List{% endblock %}

{% macro printTree(area, level = 0) %}
    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            {% if level > 0 %}
                {% for i in 0..level %}&nbsp;&nbsp;&nbsp;&nbsp;{% endfor %}
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-letter-l-small" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M10 8v8h4" />
                </svg>
            {% endif %}

            {{ area.name }}
        </div>

        <div>
            <a href="{{ url('area.edit', {area: area.id}) }}" class="btn btn-sm btn-action btn-ghost-light" data-bs-toggle="tooltip" title="Edit Area" data-bs-placement="top">
                {{ icon('pencil') }}
            </a>

            <a href="#" class="btn btn-sm btn-action btn-ghost-light" title="Delete Area" data-bs-toggle="modal" data-bs-target="#modal-delete-{{ area.id }}">
                {{ icon('trash') }}
            </a>
        </div>
    </div>

    {% embed 'ui/modal/confirm.html.twig' with {url: 'area.delete', parameters: {area: area.id}, id: area.id} %}
        {% block trigger %}{% endblock trigger %}
        {% block title %}
            Are you sure you want to delete the area {{ area.name }}?
        {% endblock %}

        {% block content %}
            {% if area.children|length > 0 %}
                <div class="text-secondary">
                    <b>Note:</b> Deleting this area will also delete the following child areas:
                    <ul>
                        {% for child in area.children %}
                            <li>{{ child.name }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endblock content %}
    {% endembed %}

    {% for child in area.children(false) %}
        {{ _self.printTree(child, level + 1) }}
    {% endfor %}
{% endmacro %}

{% block page_header %}
    {% if areas is not empty %}
        <div class="page-header d-print-none">
            <div class="container-xl">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <h2 class="page-title">
                            Areas
                        </h2>
                    </div>

                    <div class="col-auto ms-auto d-print-none">
                        <div class="btn-list">
                            <a href="{{ url('area.create') }}" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-create-area">
                                {{ icon('plus') }}
                                Create new area
                            </a>
                            <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-create-area" aria-label="Create new area">
                                {{ icon('plus') }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock page_header %}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        {% if areas is empty %}
            <div class="empty">
                <div class="empty-img">
                    {{ include('components/illustration/area.html.twig', {label: 'No areas'}) }}
                </div>
                <p class="empty-title">No areas found</p>
                <p class="empty-subtitle text-secondary">
                    Areas help by scheduling shifts for a specific area within your site.
                    <br />
                    This could be a physical area, like an office or an area in the building, or it can be a team or department within the organization.
                    <br />
                    Areas can be nested within other areas. For example, a building can have multiple floors, and each floor can have multiple rooms.
                </p>
                <div class="empty-action">
                    <a href="{{ url('area.create') }}" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M12 5l0 14"></path>
                            <path d="M5 12l14 0"></path>
                        </svg>
                        Add your first area
                    </a>
                </div>
            </div>
        {% else %}
            <div class="alert alert-indigo" role="alert">
                <div class="d-flex">
                    <div>
                        {{ icon('alert') }}
                    </div>
                    <div>
                        <div class="text-secondary">
                            Areas help by scheduling shifts for a specific area within your site.
                            <br />
                            This could be a physical area, like an office or an area in the building, or it can be a team or department within the organization.
                            <br />
                            Areas can be nested within other areas. For example, a building can have multiple floors, and each floor can have multiple rooms.
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ site.name }} Areas</h3>
                </div>
                <div class="list-group list-group-flush">
                    {% for area in areas|filter((v) => v.parent is empty) %}
                        {{ _self.printTree(area) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock body %}

{% block page_end %}
    <div class="modal modal-blur fade" id="modal-create-area" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                {{ form_start(form, {'action': path('area.create')}) }}
                <div class="modal-header">
                    <h5 class="modal-title">New Area</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {#<div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="example-text-input" placeholder="Your report name">
                    </div>
                    <label class="form-label">Report type</label>
                    <div class="form-selectgroup-boxes row mb-3">
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="report-type" value="1" class="form-selectgroup-input" checked>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                    <span class="me-3">
                      <span class="form-selectgroup-check"></span>
                    </span>
                    <span class="form-selectgroup-label-content">
                      <span class="form-selectgroup-title strong mb-1">Simple</span>
                      <span class="d-block text-secondary">Provide only basic data needed for the report</span>
                    </span>
                  </span>
                            </label>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="report-type" value="1" class="form-selectgroup-input">
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                    <span class="me-3">
                      <span class="form-selectgroup-check"></span>
                    </span>
                    <span class="form-selectgroup-label-content">
                      <span class="form-selectgroup-title strong mb-1">Advanced</span>
                      <span class="d-block text-secondary">Insert charts and additional advanced analyses to be inserted in the report</span>
                    </span>
                  </span>
                            </label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="mb-3">
                                <label class="form-label">Report url</label>
                                <div class="input-group input-group-flat">
                    <span class="input-group-text">
                      https://tabler.io/reports/
                    </span>
                                    <input type="text" class="form-control ps-0" value="report-01" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                <label class="form-label">Visibility</label>
                                <select class="form-select">
                                    <option value="1" selected>Private</option>
                                    <option value="2">Public</option>
                                    <option value="3">Hidden</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Client name</label>
                                <input type="text" class="form-control">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Reporting period</label>
                                <input type="date" class="form-control">
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div>
                                <label class="form-label">Additional information</label>
                                <textarea class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>#}
                    <div class="mb-3">
                        <div class="alert alert-indigo" role="alert">
                            <div class="d-flex">
                                <div>
                                    {{ icon('alert') }}
                                </div>
                                <div>
                                    <h4 class="alert-title">Create a new area by giving it a unique name.</h4>
                                    <div class="text-secondary">
                                        A area is any place where a person can be scheduled to be on duty.<br />
                                        This could be a physical area, like an office or an area in the building, <br />
                                        or it can be a team or department within the organization.
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{ form_widget(form) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary ms-auto">
                        {{ icon('plus') }}
                        Create new area
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock page_end %}
