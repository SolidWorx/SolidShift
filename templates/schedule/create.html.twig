{% extends 'layouts/base.html.twig' %}

{%- block title -%}
    {% if edit %}
        {{ 'Edit Schedule'|trans }}
    {% else %}
        {{ 'Create Schedule'|trans }}
    {% endif %}
{%- endblock title -%}

{% block body %}
    <div class="container-xl d-flex flex-column justify-content-center">
        <div class="row row-cards">
            <div class="col-8 offset-2">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{- block('title') -}}</h3>
                        <div class="mb-3">
                            <twig:ScheduleForm :initialFormData="schedule" :site="site" :edit="edit" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
